{
  "dependencies": [
    "."
  ],
  "graphs": {
    "agent": "agents.mentor:mentor_graph"
  },
  "checkpointer": {
    "ttl": {
      "strategy": "delete",
      "sweep_interval_minutes": 180,
      "default_ttl": 1440
    }
  },
  "python_version": "3.12",
  "base_image": "langchain/langgraph-api",
  "image_distro": "wolfi",
  "http": {
    "disable_assistants": true,
    "disable_ui": true,
    "disable_store": true,
    "disable_mcp": true,
    "disable_a2a": true
  },
  "env": ".env"
}