# Google Gemini API (required)
GOOGLE_API_KEY=your-google-api-key

# LangChain / LangSmith — pulls prompts from the Prompt Hub (required)
LANGSMITH_API_KEY=your-langsmith-api-key

# Models (required)
BIG_MODEL=gemini-3.5-flash
SMALL_MODEL=gemini-3.1-flash-lite

# Environment & logging (optional)
ENV=dev
LOG_DIR=logs
LOG_LEVEL=INFO

# Custom Postgres for LangGraph checkpointing (optional)
# POSTGRES_URI_CUSTOM=postgresql://user:pass@host:5432/yourdb
